# Application
APP_NAME=cv-tailoring-backend
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=local

# Database
DATABASE_URL=postgresql://cvapp:cvapp_local@postgres:5432/cv_tailoring
DATABASE_URL_ASYNC=postgresql+asyncpg://cvapp:cvapp_local@postgres:5432/cv_tailoring
# Runtime connection for the API process (see migration 017/018 and
# app/db/session.py). Leave unset until the app_runtime role has been
# provisioned and you're ready to cut the app over to it — until then the
# app keeps using DATABASE_URL_ASYNC above.
# DATABASE_URL_RUNTIME_ASYNC=postgresql+asyncpg://app_runtime:app_runtime_local@postgres:5432/cv_tailoring
# Password migration 017 creates the app_runtime role with. Only read by
# alembic at migration time, not by the app itself.
APP_RUNTIME_DB_PASSWORD=app_runtime_local

# Redis
REDIS_URL=redis://redis:6379/0

# AWS (for Textract + S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
S3_BUCKET_NAME=cv-tailoring-local

# MinIO (local S3-compatible storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Textract
TEXTRACT_ENABLED=false

# LLM provider (Phase 3, placeholder)
OPENAI_API_KEY=placeholder
# Structured/judgement tasks (analysis, classification, extraction).
OPENAI_MODEL=gpt-5-mini
# Prose-quality generation (resume rewrite, cover letters).
OPENAI_MODEL_GENERATION=gpt-5-mini

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=604800

# Rate limiting (tiered per security plan)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_GENERATION_REQUESTS=20
RATE_LIMIT_GENERATION_WINDOW=3600
RATE_LIMIT_URL_FETCH_REQUESTS=20
RATE_LIMIT_URL_FETCH_WINDOW=3600

# Max concurrent in-flight processing jobs per user
MAX_CONCURRENT_JOBS_PER_USER=5

# ClamAV
CLAMD_HOST=clamav
CLAMD_PORT=3310

# CORS
# Port 3000 is Grafana in this compose file — the frontend runs on 3100.
CORS_ORIGIN=http://localhost:3100

# Free-API job feed (item 7) — RemoteOK/Remotive/Arbeitnow need no key
# and refresh regardless. Reed and USAJobs are skipped (logged, not an
# error) until their free keys are set.
JOB_FEED_REFRESH_INTERVAL_SECONDS=10800
REED_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=